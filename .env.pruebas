# Proyecto de Firebase de PRUEBAS. Lo usan `npm run dev` y `npm run deploy:pruebas`.
# Producción está en `.env.produccion`.
# Estos valores son públicos por diseño: la seguridad la dan Authentication y firestore.rules.
VITE_FIREBASE_API_KEY=AIzaSyDOda3blcbXK2I1VgGaRyMDPSP5BrnlLHY
VITE_FIREBASE_AUTH_DOMAIN=punto-venta-7fa81.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=punto-venta-7fa81
VITE_FIREBASE_STORAGE_BUCKET=punto-venta-7fa81.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=782980453983
VITE_FIREBASE_APP_ID=1:782980453983:web:7a6f62e43dd75c09362dea
VITE_FIREBASE_MEASUREMENT_ID=G-X2Z8LTQBRS

# Nombre que se muestra en la app para saber a qué base está conectada (vacío = no mostrar)
VITE_ENVIRONMENT_LABEL=Pruebas

# true = activar funciones de administración (requiere plan Blaze y desplegar functions/)
VITE_ADMIN_FUNCTIONS=false

# true = mostrar la impresión de tickets (pantalla Impresora, botones de imprimir).
# Sin esta línea, o con otro valor, la app no muestra nada de impresión.
VITE_PRINTING=true
