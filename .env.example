# Copia este archivo como `.env.production.local` (no se sube a git) o carga estas
# variables en tu hosting, con los datos de: consola de Firebase → Configuración del
# proyecto → Tus apps → Configuración del SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ENVIRONMENT_LABEL=
VITE_ADMIN_FUNCTIONS=false
