# Proyecto de Firebase de PRODUCCIÓN (la base real del bar).
# Llénalo con: consola de Firebase → ⚙️ Configuración del proyecto → Tus apps → app web →
# Configuración del SDK (opción "Configuración"). Estos valores son públicos por diseño;
# lo que protege los datos son Authentication y las reglas (firestore.rules).
# `npm run deploy:prod` se niega a publicar mientras falten datos o apunten a pruebas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# En producción no se muestra ninguna etiqueta
VITE_ENVIRONMENT_LABEL=
VITE_ADMIN_FUNCTIONS=false
